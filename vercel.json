{
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    {
      "source": "/movies",
      "destination": "/api/movies"
    },
    {
      "source": "/movies/:path*",
      "destination": "/api/movies/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
